{
  "volatile_keys": ["collected_at", "saved", "more.params.id"],
  "scenarios": [
    {
      "id": "version",
      "title": "Installed version",
      "argv": ["--version"]
    },
    {
      "id": "help",
      "title": "Top-level help",
      "argv": ["--help"]
    },
    {
      "id": "list",
      "title": "List commands",
      "argv": ["list"]
    },
    {
      "id": "describe",
      "title": "Describe modules and commands",
      "argv": ["describe"]
    },
    {
      "id": "invoke-describe",
      "title": "Invoke the describe command",
      "argv": ["invoke", "housesitter.describe"]
    },
    {
      "id": "doctor",
      "title": "Doctor findings on an empty home",
      "argv": ["doctor"]
    },
    {
      "id": "config-check",
      "title": "Config check with defaults",
      "argv": ["config-check"]
    },
    {
      "id": "dropins-print",
      "title": "Drop-in files as JSON",
      "argv": ["dropins", "--print", "--exec", "/opt/housesitter/bin/housesitter"]
    },
    {
      "id": "install-dry-run",
      "title": "Install commands dry run",
      "argv": ["install-commands", "--dry-run", "--exec", "/opt/housesitter/bin/housesitter"]
    },
    {
      "id": "invoke-unknown",
      "title": "Invoke an unknown command",
      "argv": ["invoke", "housesitter.nope.snapshot"],
      "expect_exit": 1
    },
    {
      "id": "invoke-bad-params",
      "title": "Invoke with a wrongly typed param",
      "argv": ["invoke", "housesitter.doctor", "--params", "{\"check\": \"yes\"}"],
      "expect_exit": 1
    },
    {
      "id": "invoke-unifi-wifi-snapshot",
      "title": "Snapshot with no config (config_invalid)",
      "argv": ["invoke", "housesitter.unifi_wifi.snapshot"],
      "expect_exit": 1
    },
    {
      "id": "unifi-wifi-snapshot-typical",
      "title": "Snapshot from the fake controller (typical house)",
      "argv": ["invoke", "housesitter.unifi_wifi.snapshot"],
      "fake": {"fixture_set": "typical"}
    },
    {
      "id": "unifi-wifi-snapshot-empty",
      "title": "Snapshot from the fake controller (empty house)",
      "argv": ["invoke", "housesitter.unifi_wifi.snapshot"],
      "fake": {"fixture_set": "empty"}
    },
    {
      "id": "unifi-wifi-snapshot-auth-rejected",
      "title": "Snapshot with the login rejected (upstream_auth)",
      "argv": ["invoke", "housesitter.unifi_wifi.snapshot"],
      "fake": {"fixture_set": "typical", "reject_login": true},
      "expect_exit": 1
    },
    {
      "id": "unifi-wifi-snapshot-tls-mismatch",
      "title": "Snapshot with a wrong certificate fingerprint (upstream_tls)",
      "argv": ["invoke", "housesitter.unifi_wifi.snapshot"],
      "fake": {"fixture_set": "typical", "bad_fingerprint": true},
      "expect_exit": 1
    },
    {
      "id": "unifi-wifi-snapshot-large",
      "title": "Snapshot from the large fixture, truncated, plus its first follow-up page",
      "argv": ["invoke", "housesitter.unifi_wifi.snapshot"],
      "fake": {"fixture_set": "large"},
      "render": "data-counts",
      "steps": [
        {"argv": ["invoke", "housesitter.unifi_wifi.snapshot"]},
        {"argv": ["invoke", "$more_command(0)", "--params", "$more_params(0)"]}
      ]
    },
    {
      "id": "unifi-wifi-get-saved",
      "title": "Get of the snapshot just taken",
      "argv": ["invoke", "housesitter.unifi_wifi.get", "--params", "{\"id\": \"$saved_id(0)\"}"],
      "fake": {"fixture_set": "empty"},
      "steps": [
        {"argv": ["invoke", "housesitter.unifi_wifi.snapshot"]},
        {"argv": ["invoke", "housesitter.unifi_wifi.get", "--params", "{\"id\": \"$saved_id(0)\"}"]}
      ]
    }
  ]
}
